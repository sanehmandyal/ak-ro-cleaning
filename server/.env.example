NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ro-cleaning?retryWrites=true&w=majority

# Long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=https://ak-ro-cleaning.vercel.app,http://localhost:5173
# Public site URL, used in sitemap.xml and robots.txt
SITE_URL=https://ak-ro-cleaning.vercel.app

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# First admin account, created by `npm run seed`
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123
